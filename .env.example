# --- Secrets ---
# Required for LLM calls (OpenRouter / opencode harness).
# Surrounding whitespace is trimmed before the key is used, so a value
# pasted with a trailing newline still works. OpenRouter rejects an
# untrimmed key with 401 "User not found." — identical to the error for a
# key that does not exist, which makes it easy to misread as invalid.
OPENROUTER_API_KEY=

# GitHub PAT for clone/post; optional if using GitHub App auth below
GH_TOKEN=

# --- AgentField ---
# Leave both URLs COMMENTED OUT for docker compose. The compose files supply the
# container-network values (http://agentfield:8080 and the node's own
# http://pr-af:8004 / http://pr-af-go:8007) as defaults, and setting either here
# overrides that default for every service — a localhost/127.0.0.1 value cannot
# cross a container boundary and will break a compose run.
# Set them only when running a node directly on the host (python -m pr_af.app),
# or to point at a control plane outside compose. AGENT_CALLBACK_URL is the
# address the control plane calls BACK on, so it must name the node's own
# host/port; do not pin it in a shared .env when running both nodes.
# AGENTFIELD_SERVER=http://localhost:8080
# AGENT_CALLBACK_URL=http://127.0.0.1:8004
AGENTFIELD_API_KEY=
# Public CP URL for HITL webhooks (Railway cross-project); leave empty for local single-project setups
AGENTFIELD_PUBLIC_URL=
NODE_ID=pr-af

# --- AI / harness config ---
# AForge exec is the default. Set PR_AF_PROVIDER=opencode to roll back.
PR_AF_PROVIDER=aforge
# Read by the Go node's SDK adapter; the pinned Python SDK always runs `exec`.
AGENTFIELD_AFORGE_COMMAND=exec
# An OpenRouter slug (<vendor>/<model>). The `openrouter/` routing prefix is
# optional — it is added where needed (the .ai() gates' LiteLLM routing, the
# generated opencode config) and stripped where it is not (the Go .ai() client,
# the aforge CLI), so both forms behave identically.
PR_AF_MODEL=deepseek/deepseek-v4-flash-0731
# Falls back to PR_AF_MODEL when unset
# PR_AF_AI_MODEL=
PR_AF_MAX_TURNS=50
PR_AF_AI_MAX_RETRIES=3
PR_AF_AI_INITIAL_BACKOFF_SECONDS=2.0
PR_AF_AI_MAX_BACKOFF_SECONDS=8.0
PR_AF_OPENCODE_BIN=opencode
PR_AF_AFORGE_BIN=aforge
# Optional provider-agnostic harness executable override (leave unset to use provider defaults)
# PR_AF_HARNESS_BIN=
PR_AF_OPENCODE_SERVER=
# Harness no-output watchdog window (seconds). Harness CLIs in JSON mode emit
# events only at completion boundaries, so long single completions look silent.
AGENTFIELD_HARNESS_IDLE_SECONDS=360

# Alternate LLM provider keys (forwarded to harness when set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Review budget / repo paths ---
PR_AF_MAX_COST_USD=2.0
PR_AF_MAX_DURATION_SECONDS=3600
PR_AF_WORKDIR=/workspaces
# Wall-clock ceiling for every git subprocess (clone, fetch, checkout, diff).
# Raise it for large monorepos: the previous hardcoded 30s checkout timeout
# killed reviews of big repos with "git checkout ... timed out after 30 seconds"
# while git was still writing the working tree. Invalid/non-positive values fall
# back to the default rather than disabling the timeout.
PR_AF_GIT_TIMEOUT_SECONDS=600
# Skip Git-LFS content download at checkout (exports GIT_LFS_SKIP_SMUDGE=1).
# Default true: LFS-tracked files check out as small pointer stubs instead of
# real content, which is what you want for large binary assets (Unity, game
# art, ML weights) — the reviewers read source, not binaries. Set to 0/false
# only if a review genuinely needs the binary contents; the Docker images
# install and register git-lfs so that opt-in works.
PR_AF_SKIP_GIT_LFS=true
# Defaults to cwd when unset
PR_AF_REPO_PATH=
# Use /home/praf/.local/share in docker; set a host path when running outside docker
XDG_DATA_HOME=/home/praf/.local/share

# --- GitHub auth alternatives + webhooks ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
PR_AF_BOT_MENTION=@pr-af
# Adding this label to a PR triggers a review via webhook (alt to @mention)
PR_AF_LABEL=pr-af
# Optional per-deployment caps (unset = defaults). Applied to BOTH
# webhook-triggered reviews and scripts/ci_runner.py runs, so a host tuned to
# survive these limits keeps them whichever way a review is triggered.
# Useful to protect a small/shared host from resource spikes.
# PR_AF_MAX_CONCURRENT_REVIEWERS=1
# PR_AF_MAX_REVIEW_DEPTH=0
# PR_AF_MAX_COVERAGE_ITERATIONS=1

# --- Human-in-the-loop (optional) ---
# Set HAX_API_KEY to enable HITL review gate
HAX_API_KEY=
HAX_SDK_URL=http://localhost:3000
AGENTFIELD_APPROVAL_USER_ID=

# --- CI script (optional for local dev) ---
# Required only when running scripts/ci_runner.py
PR_URL=
# Tail the execution's structured events as they arrive and poll more often,
# instead of one coarse status line every 30s. Same as passing --verbose.
PR_AF_CI_VERBOSE=0
# Review depth the CI script requests (default: standard)
PR_AF_CI_DEPTH=standard

# --- Docker Compose agentfield service ---
# Used by docker compose up; not read by PR-AF Python code directly
AF_MODE=dev
AGENTFIELD_HTTP_ADDR=0.0.0.0:8080
AGENTFIELD_STORAGE_MODE=local
